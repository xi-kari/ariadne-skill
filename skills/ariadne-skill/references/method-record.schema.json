            "deadline": {"type": "string", "format": "date-time"}
          }
        },
        "object_scope": {"type": "string", "minLength": 1},
        "baseline_time": {"type": "string", "format": "date-time"},
        "input_cutoff": {"type": "string", "format": "date-time"},
        "information_set_ids": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "simple_baseline": {"type": "string", "minLength": 1},
        "candidate_mechanisms": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 2, "uniqueItems": true},
        "paths": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 2, "uniqueItems": true},
        "recursion_stage": {"type": "integer", "minimum": 0, "maximum": 3},
        "expression": {"type": "string", "minLength": 1},
        "evaluation_rule": {"type": "string", "minLength": 1},
        "response_regime": {"type": "string", "minLength": 1},
        "calibration_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "reference_class", "minimum_cases"],
          "properties": {
            "metric": {"type": "string", "minLength": 1},
            "reference_class": {"type": "string", "minLength": 1},
            "minimum_cases": {"type": "integer", "minimum": 1}
          }
        },
        "early_signals": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "reverse_signals": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "review_triggers": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "pause_conditions": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "retirement_conditions": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "failure_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "not_supported", "unresolved", "target_invalid", "not_evaluable"],
          "properties": {
            "supported": {"type": "string", "minLength": 1},
            "not_supported": {"type": "string", "minLength": 1},
            "unresolved": {"type": "string", "minLength": 1},
            "target_invalid": {"type": "string", "minLength": 1},
            "not_evaluable": {"type": "string", "minLength": 1}
          }
        },
        "result_writeback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "due_at", "destination"],
          "properties": {
            "owner": {"type": "string", "minLength": 1},
            "due_at": {"type": "string", "format": "date-time"},
            "destination": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "forecastPostHocReconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_version",
