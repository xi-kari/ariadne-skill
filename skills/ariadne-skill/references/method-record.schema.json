        "deadline",
        "input_cutoff",
        "available_information_ids",
        "model_version",
        "simple_baseline",
        "expression",
        "evaluation_rule",
        "early_signals",
        "reverse_signals",
        "actual_outcome",
        "hindsight_exclusions",
        "calibration",
        "failure_classification"
      ],
      "properties": {
        "record_id": {"type": "string", "pattern": "^ariadne:[A-Za-z0-9._:-]+$"},
        "record_version": {"type": "integer", "minimum": 1},
        "original_question": {"type": "string", "minLength": 1},
        "reconstruction_time": {"type": "string", "format": "date-time"},
        "target": {"type": "string", "minLength": 1},
        "deadline": {"type": "string", "format": "date-time"},
        "input_cutoff": {"type": "string", "format": "date-time"},
        "available_information_ids": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "model_version": {"type": "string", "minLength": 1},
        "simple_baseline": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "evaluation_rule": {"type": "string", "minLength": 1},
        "early_signals": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "reverse_signals": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "actual_outcome": {"type": "string", "minLength": 1},
        "hindsight_exclusions": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1},
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "assessment", "baseline_comparison", "limitations"],
          "properties": {
            "metric": {"type": "string", "minLength": 1},
            "assessment": {"type": "string", "minLength": 1},
            "baseline_comparison": {"type": "string", "minLength": 1},
            "limitations": {"$ref": "#/$defs/nonEmptyStringArray", "minItems": 1}
          }
        },
        "failure_classification": {"enum": ["supported", "not_supported", "unresolved", "target_invalid", "not_evaluable"]}
