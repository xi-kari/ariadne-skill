        "post_hoc_reconstruction": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/forecastPostHocReconstruction"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "preregistration": {"$ref": "#/$defs/forecastPreregistration"},
            "post_hoc_reconstruction": {"type": "null"}
          }
        },
        {
          "properties": {
            "preregistration": {"type": "null"},
            "post_hoc_reconstruction": {"$ref": "#/$defs/forecastPostHocReconstruction"}
          }
        }
      ]
    },
    "forecastPreregistration": {
