        "model_version",
        "target",
        "horizon",
        "object_scope",
        "baseline_time",
        "input_cutoff",
        "information_set_ids",
        "simple_baseline",
        "candidate_mechanisms",
        "paths",
        "recursion_stage",
        "expression",
        "evaluation_rule",
        "response_regime",
        "calibration_plan",
        "early_signals",
        "reverse_signals",
        "review_triggers",
        "pause_conditions",
        "retirement_conditions",
        "failure_semantics",
        "result_writeback"
      ],
      "properties": {
        "forecast_id": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "pattern": "^ariadne:[A-Za-z0-9._:-]+$"},
        "record_version": {"type": "integer", "minimum": 1},
        "model_version": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "deadline"],
