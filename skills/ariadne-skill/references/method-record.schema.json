    "forecastPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preregistration", "post_hoc_reconstruction"],
      "properties": {
        "preregistration": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/forecastPreregistration"}
