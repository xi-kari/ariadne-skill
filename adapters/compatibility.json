{
  "schema_version": 1,
  "source_of_truth": "skills",
  "default_bundle": "complete",
  "release_channel": "rolling-main",
  "windows_install_mode": "copy",
  "agent_skills_spec_url": "https://agentskills.io/specification",
  "installer_evidence_url": "https://github.com/vercel-labs/skills",
  "router_only_degradation": {
    "installed_skills": [
      "ariadne-skill"
    ],
    "missing_peer_status": "module_unavailable",
    "semantic_equivalence": false
